# ---------------------------------------------------------------------------
# Off-Label Radar — copy to `.env` and fill in the blanks.   `.env` is git-ignored.
# Load it with:  uv run --env-file .env ...     (or:  set -a; . ./.env; set +a)
# ---------------------------------------------------------------------------

# --- Jev / TypeSafe AI (REQUIRED for a local build) ---------------------------
# Get a key at https://typesafe.ai  · API docs: https://docs.typesafe.ai/api
# Jev bills input tokens only (~4¢ per million); a 10-drug run is ~5¢.
TYPESAFE_API_KEY=
# Pin a version for reproducible demos, e.g. jev-1.13.0 (jev-latest moves).
JEV_MODEL=jev-latest

# --- Identify yourself to the public APIs (be a polite client) ----------------
# Goes into the User-Agent and into every NCBI E-utilities request (NCBI requires it).
CONTACT_EMAIL=you@example.com
# Optional. Free key raises PubMed from 3 req/s to 10 req/s:
# https://www.ncbi.nlm.nih.gov/account/settings/  → "API Key Management"
NCBI_API_KEY=

# --- Pipeline knobs -----------------------------------------------------------
OFF_LABEL_THRESHOLD=0.6          # gate: P(off-label) below this → "label covers it" bucket, no evidence pulled
MAX_TRIALS_PER_DRUG=40           # newest N active trials per drug (drug mode) / per condition search
MAX_DRUGS_PER_CONDITION=30       # condition mode: keep the N most-tested ingredients
RADAR_DB=radar.db                # SQLite file (labels, trials, pairs, abstracts, every Jev request/response)

# --- Only when running inside a PromptQL VM — leave blank for a local build ---
# When set, Jev is reached through the PromptQL integration proxy using the visitor's session
# instead of TYPESAFE_API_KEY, and the app can be published as a PromptQL App Artifact.
PROMPTQL_PLATFORM_API_URL=
PROMPTQL_THREAD_ID=
JEV_PROVIDER=__typesafe-api