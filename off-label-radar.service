[Unit]
Description=Off-Label Radar (CT.gov x DailyMed x PubMed -> Jev)
After=network-online.target
Wants=network-online.target

[Service]
User=promptql
WorkingDirectory=/workspace/off-label-radar
EnvironmentFile=/workspace/off-label-radar/.env
ExecStart=/workspace/off-label-radar/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080 --log-level info
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target